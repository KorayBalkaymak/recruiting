# -----------------------------------------------------------------------------
# Demo vs Live (fail-closed)
# -----------------------------------------------------------------------------
# Demo ONLY when explicitly enabled:
#   NEXT_PUBLIC_DEMO_MODE=true
# Missing/empty/placeholder values must NEVER silently enable demo.
#
# Safe default below is LIVE (demo off). For local demo, set:
#   NEXT_PUBLIC_DEMO_MODE=true
#   DEMO_SESSION_SECRET=<random >= 32 chars>
#
# Demo session signing secret (>= 32 chars) for BOTH
# staff (cms-demo-user) and candidate (cms-demo-candidate) signed cookies:
#   DEMO_SESSION_SECRET=...   (preferred)
#   or BETTER_AUTH_SECRET=... (fallback for local demo)
#
# Live (NEXT_PUBLIC_DEMO_MODE unset/false) requires:
#   DATABASE_URL          (Neon test branch recommended, e.g. ba3-test — not production)
#   BETTER_AUTH_SECRET (>= 32 chars)
#   BETTER_AUTH_URL or NEXT_PUBLIC_APP_URL
# Live CRM uses Drizzle/getDb only; createClient() throws outside demo.
# Live must never silently fall back to demo auth.
# Middleware resolves Better Auth session + role (not cookie presence alone).
# -----------------------------------------------------------------------------

# Default: live / demo off. Flip to true only for intentional local demo.
NEXT_PUBLIC_DEMO_MODE=false
# DEMO_SESSION_SECRET=replace-with-a-long-random-demo-session-secret-32+

# Optional legacy Supabase keys (demo adapter only; unused in live CRM).
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Neon-PostgreSQL. Nur serverseitig verwenden. Keine echten Zugangsdaten einchecken.
# Prefer isolated ba3-test — never production for local/dev cutover work.
# Local: quotes OK if the URL contains & (dotenv strips them).
# Vercel: paste WITHOUT quotes — surrounding "…" cause ERR_INVALID_URL / Failed query.
# App also accepts POSTGRES_URL / DATABASE_URL_UNPOOLED (Vercel Neon integration).
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# Better Auth (Live-Modus). Secret mind. 32 Zeichen. Auch Fallback für Demo-Session-Signatur.
BETTER_AUTH_SECRET=replace-with-a-long-random-secret-at-least-32-chars
BETTER_AUTH_URL=http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Privater Dokumentenspeicher (S3-kompatibel). Bucket muss privat bleiben.
# Bevorzugt Backblaze B2 (alle fünf Pflicht — siehe docs/b2-setup.md):
# B2_KEY_ID=
# B2_APPLICATION_KEY=
# B2_BUCKET_NAME=
# B2_ENDPOINT=https://s3.<region>.backblazeb2.com
# B2_REGION=
#
# Optional Fallback Cloudflare R2 (siehe docs/r2-setup.md):
# R2_ACCOUNT_ID=
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# R2_BUCKET=
# R2_ENDPOINT=
# R2_REGION=auto

# Transaktionale E-Mails (Resend). Nur serverseitig.
# Live-Versand (Mitarbeiter-Einladung, Passwort-Reset, Portal-Status) erfordert:
#   RESEND_API_KEY=re_...
#   EMAIL_FROM="CMS Recruiting <noreply@your-domain.com>"
# Domain muss in Resend DNS-verifiziert sein (siehe docs/resend-setup.md).
# Optional:
#   EMAIL_REPLY_TO=support@your-domain.com
#   EMAIL_NOTIFY_TO=recruiting@your-domain.com   # Staff-Hinweis bei Profileinreichung
# Ohne diese Werte: Demo unverändert; Live fail-closed (kein Versand, klare Fehlermeldung).
# Keine echten Mails ohne Freigabe. Prep: node scripts/r2-resend-prep-smoke.mjs
# RESEND_API_KEY=
# EMAIL_FROM=
# EMAIL_REPLY_TO=
# EMAIL_NOTIFY_TO=

# -----------------------------------------------------------------------------
# Rate-Limit Backend (Auth / Register / Reset / CV-Upload)
# -----------------------------------------------------------------------------
# Default: memory (single-process). Aufrufer nutzen enforceRateLimit() — Backend
# kann später auf Redis wechseln, ohne Call-Sites zu ändern.
# RATE_LIMIT_BACKEND=memory
#
# Multi-Instance (vorbereitet, Client noch nicht verdrahtet):
#   RATE_LIMIT_BACKEND=redis
#   REDIS_URL=redis://USER:PASSWORD@HOST:PORT
# Ohne REDIS_URL oder ohne verdrahteten Redis-Client: Fallback auf memory + Warnung.
# Keine echten Redis-Credentials hier eintragen.
# RATE_LIMIT_BACKEND=memory
# REDIS_URL=
